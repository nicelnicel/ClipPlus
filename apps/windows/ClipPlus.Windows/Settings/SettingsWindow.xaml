<Window x:Class="ClipPlus.Windows.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipPlus 设置"
        Height="520"
        Width="520">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="共享" FontWeight="Bold" />
            <TextBlock Text="{Binding LastStatusMessage}" Margin="0,4,0,8" />
            <CheckBox Content="启用剪贴板共享" IsChecked="{Binding SharingEnabled}" />
            <TextBlock Text="共享 Key" Margin="0,8,0,0" />
            <TextBox Text="{Binding SharedKeyInput, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="再次输入共享 Key" Margin="0,8,0,0" />
            <TextBox Text="{Binding SharedKeyConfirmationInput, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="保存 Key" Width="120" HorizontalAlignment="Left" Margin="0,8,0,0" Click="SaveKey_Click" />
            <TextBlock Text="{Binding PendingPeerCount, StringFormat=待确认设备：{0}}" Margin="0,16,0,0" />
            <ItemsControl ItemsSource="{Binding PendingPeerSummaries}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,4,0,0">
                            <Button Content="允许"
                                    Width="64"
                                    DockPanel.Dock="Right"
                                    Tag="{Binding DeviceId}"
                                    Click="ApprovePendingPeer_Click" />
                            <StackPanel>
                                <TextBlock Text="{Binding DeviceName}" />
                                <TextBlock Text="{Binding ShortDeviceId, StringFormat=ID {0}}"
                                           FontSize="11"
                                           Foreground="Gray" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="允许全部待确认设备" Width="160" HorizontalAlignment="Left" Margin="0,8,0,0" Click="ApprovePendingPeers_Click" />
            <Button Content="{Binding RemoteFileOffer.DisplayTitle, TargetNullValue=暂无可接收文件, FallbackValue=暂无可接收文件}"
                    Width="180"
                    HorizontalAlignment="Left"
                    Margin="0,8,0,0"
                    IsEnabled="{Binding HasRemoteFileOffer}"
                    Click="ReceiveRemoteFiles_Click" />
            <TextBlock Text="系统" FontWeight="Bold" Margin="0,16,0,0" />
            <CheckBox Content="开机自动启动" IsChecked="{Binding StartupEnabled}" />
            <Button Content="导出诊断包" Width="120" HorizontalAlignment="Left" Click="ExportDiagnostics_Click" />
        </StackPanel>
    </ScrollViewer>
</Window>
