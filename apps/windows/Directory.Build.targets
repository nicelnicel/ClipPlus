<Project>
  <PropertyGroup>
    <ClipPlusRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))</ClipPlusRepoRoot>
    <ClipPlusCargoTargetDir Condition="'$(ClipPlusCargoTargetDir)' == ''">$(TEMP)\ClipPlusRustTarget</ClipPlusCargoTargetDir>
    <ClipPlusCargoProfile Condition="'$(Configuration)' == 'Release'">release</ClipPlusCargoProfile>
    <ClipPlusCargoProfile Condition="'$(ClipPlusCargoProfile)' == ''">debug</ClipPlusCargoProfile>
    <ClipPlusCargoArgs Condition="'$(Configuration)' == 'Release'">--release</ClipPlusCargoArgs>
    <ClipPlusCargoTargetArgs Condition="'$(ClipPlusCargoTarget)' != ''">--target $(ClipPlusCargoTarget)</ClipPlusCargoTargetArgs>
    <ClipPlusCargoOutputDir Condition="'$(ClipPlusCargoTarget)' != ''">$(ClipPlusCargoTargetDir)\$(ClipPlusCargoTarget)\$(ClipPlusCargoProfile)</ClipPlusCargoOutputDir>
    <ClipPlusCargoOutputDir Condition="'$(ClipPlusCargoOutputDir)' == ''">$(ClipPlusCargoTargetDir)\$(ClipPlusCargoProfile)</ClipPlusCargoOutputDir>
    <ClipPlusFfiDll>$(ClipPlusCargoOutputDir)\clipplus_ffi.dll</ClipPlusFfiDll>
  </PropertyGroup>

  <Target Name="BuildAndCopyClipPlusFfi" BeforeTargets="PrepareForBuild" Condition="'$(OS)' == 'Windows_NT'">
    <Message Importance="high" Text="Building clipplus-ffi native library into $(ClipPlusCargoTargetDir)" />
    <MakeDir Directories="$(OutDir)" />
    <Exec Command="set &quot;CARGO_TARGET_DIR=$(ClipPlusCargoTargetDir)&quot; &amp;&amp; cargo build -p clipplus-ffi $(ClipPlusCargoArgs) $(ClipPlusCargoTargetArgs)" WorkingDirectory="$(ClipPlusRepoRoot)" />
    <Copy SourceFiles="$(ClipPlusFfiDll)" DestinationFolder="$(OutDir)" />
    <ItemGroup>
      <EmbeddedResource Include="$(ClipPlusFfiDll)" LogicalName="clipplus_ffi.dll" />
    </ItemGroup>
  </Target>
</Project>
